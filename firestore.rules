rules_version = '2';

// Security model
// --------------
// Firestore evaluates rules as a logical OR: if any match grants access, the
// request succeeds. A blanket `match /{document=**} { allow read, write: if
// false; }` therefore denies nothing — it only reads as if it does. Access is
// denied by default when no rule matches, so the deny-all is deliberately
// absent and every path below is opt-in.
//
// Server-owned fields (message quota, WhatsApp session, delivery state) are
// written exclusively by Cloud Functions via the Admin SDK, which bypasses
// these rules. Clients are blocked from writing them here, because a staff
// user who could raise whatsappMessagesLimit could grant themselves unlimited
// messaging, and one who could edit an invoice's delivery record could
// replay a paid receipt at will.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userGarageId() {
      return userProfile().garageId;
    }

    function userRole() {
      return userProfile().role;
    }

    function isSuper() {
      return isSignedIn() && userRole() == 'BOSS';
    }

    // A BOSS oversees every garage; everyone else is confined to their own.
    function belongsToGarage(garageId) {
      return isSignedIn() && (userGarageId() == garageId || isSuper());
    }

    function isStaffRole() {
      return userRole() in [
        'owner', 'manager', 'technician', 'receptionist',
        'store_keeper', 'cashier', 'BOSS'
      ];
    }

    function isManagerRole() {
      return userRole() in ['owner', 'manager', 'BOSS'];
    }

    // True when an update touches none of `fields` — added, removed, or
    // altered. affectedKeys() covers all three, which a value comparison
    // alone would miss (a deleted field compares as absent, not changed).
    function unchangedAll(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(fields.toSet());
    }

    // ---- Users -------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuper());
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.garageId is string
                    && request.resource.data.role is string
                    // A self-created profile may never mint a BOSS.
                    && request.resource.data.role != 'BOSS';
      // Role and garage are identity, not preferences: changing either is
      // privilege escalation, so both are pinned to their stored values.
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && unchangedAll(['garageId', 'role']);
    }

    // ---- Garages -----------------------------------------------------
    match /garages/{garageId} {
      // Fields only the backend may set. Listed once and reused so a new
      // server-owned field cannot be added to one rule and forgotten in
      // another.
      function serverOwnedGarageFields() {
        return [
          'whatsappMessagesUsed',
          'whatsappMessagesLimit',
          'whatsappQuotaPeriod',
          'whatsappQuotaUpdatedAt',
          'whatsappSessionId',
          'whatsappSessionStatus',
          'whatsappSessionPhone',
          'whatsappSessionCheckedAt',
          'ownerId'
        ];
      }

      allow read: if belongsToGarage(garageId);
      allow create: if isSignedIn()
                    && request.auth.uid == garageId
                    && request.resource.data.ownerId == request.auth.uid
                    // A new garage cannot arrive pre-loaded with quota.
                    && !request.resource.data.keys().hasAny([
                      'whatsappMessagesUsed', 'whatsappMessagesLimit',
                      'whatsappSessionId'
                    ]);
      allow update: if belongsToGarage(garageId)
                    && isStaffRole()
                    && unchangedAll(serverOwnedGarageFields());
      allow delete: if false;

      // ---- Invoices --------------------------------------------------
      match /invoices/{invoiceId} {
        allow read: if belongsToGarage(garageId);
        allow create: if belongsToGarage(garageId) && isStaffRole()
                      && !request.resource.data.keys()
                        .hasAny(['whatsappPaid', 'whatsappIssued']);
        // Delivery records are written by the Admin SDK only. Letting a
        // client clear one would allow unlimited re-sends of the same
        // receipt, each billed against the garage's quota.
        allow update: if belongsToGarage(garageId) && isStaffRole()
                      && unchangedAll(['whatsappPaid', 'whatsappIssued']);
        allow delete: if belongsToGarage(garageId) && isManagerRole();
      }

      // ---- WhatsApp audit log ----------------------------------------
      // Readable for support and billing disputes; append-only from the
      // server so the record cannot be edited after the fact.
      match /whatsappLogs/{logId} {
        allow read: if belongsToGarage(garageId) && isManagerRole();
        allow write: if false;
      }

      // ---- Scheduled broadcasts --------------------------------------
      match /scheduledMessages/{messageId} {
        allow read: if belongsToGarage(garageId);
        allow create: if belongsToGarage(garageId) && isManagerRole()
                      && request.resource.data.message is string
                      && request.resource.data.message.size() > 0
                      && request.resource.data.message.size() <= 4096
                      && request.resource.data.sendDate is string
                      && request.resource.data.sendDate.matches('\\d{4}-\\d{2}-\\d{2}')
                      && request.resource.data.status == 'pending';
        // Send progress (status, sentCount, lastClientId) belongs to the
        // scheduler; an operator may cancel, but not rewrite history.
        allow update: if belongsToGarage(garageId) && isManagerRole()
                      && request.resource.data.status == 'cancelled'
                      && resource.data.status == 'pending';
        allow delete: if belongsToGarage(garageId) && isManagerRole()
                      && resource.data.status != 'in_progress';
      }

      // ---- Archived record chunks ------------------------------------
      // A month-close snapshot stores its jobs and invoices as chunks one
      // level deeper than the wildcard below reaches ({docId} matches a
      // single path segment), so this path needs its own rule or the
      // archive would be write-denied and unreadable.
      match /archives/{archiveId}/records/{chunkId} {
        allow read: if belongsToGarage(garageId);
        allow write: if belongsToGarage(garageId) && isManagerRole();
      }

      // ---- Everything else under a garage ----------------------------
      // clients, vehicles, jobs, stock, reminders, archives.
      //
      // This wildcard also matches the collections handled above, and rules
      // combine with OR — so without the exclusion list a broad `allow write`
      // here would silently re-grant everything the specific rules just
      // withheld (delivery records, audit log, broadcast progress).
      match /{collectionName}/{docId} {
        function hasOwnWriteRule() {
          return collectionName in [
            'invoices', 'whatsappLogs', 'scheduledMessages'
          ];
        }

        // Only the audit log narrows *read* access beyond "any staff in this
        // garage", so it is the one collection the wildcard read must skip.
        function hasOwnReadRule() {
          return collectionName == 'whatsappLogs';
        }

        allow read: if belongsToGarage(garageId) && !hasOwnReadRule();
        allow write: if belongsToGarage(garageId)
                     && isStaffRole()
                     && !hasOwnWriteRule();
      }
    }

    // ---- Shared infrastructure state ---------------------------------
    // VM state is written by Cloud Functions; the dashboard reads it through
    // the getVmStatus callable, so no client access is granted here.
    match /system/{docId} {
      allow read, write: if false;
    }
  }
}
